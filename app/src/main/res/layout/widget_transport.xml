<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_controls" android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center" android:orientation="horizontal">
    <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:src="@drawable/widget_previous" android:contentDescription="上一条" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="6dp" android:scaleType="centerInside" />
    <ImageButton android:id="@+id/widget_back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:visibility="gone"
        android:src="@drawable/widget_back" android:contentDescription="后退15秒" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:scaleType="fitCenter" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/widget_play" android:contentDescription="播放" android:background="@drawable/widget_play_background" android:padding="14dp" android:scaleType="fitCenter" />
    <ImageButton android:id="@+id/widget_forward" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:visibility="gone"
        android:src="@drawable/widget_forward" android:contentDescription="前进15秒" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="12dp" android:scaleType="fitCenter" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
        android:src="@drawable/widget_next" android:contentDescription="下一条" android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="6dp" android:scaleType="centerInside" />
</LinearLayout>
