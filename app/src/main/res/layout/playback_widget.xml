<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:padding="8dp" android:orientation="horizontal" android:background="@drawable/widget_strip_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_cover" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/widget_cover_placeholder"
            android:background="@drawable/widget_album_frame" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="6dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="哔哩听视频" android:textSize="15sp" android:textStyle="bold" android:textColor="#24262B"
    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:text="尚未播放" android:textSize="11sp" android:textColor="#686C74"
    android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <include layout="@layout/widget_progress" />
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/widget_transport" android:layout_width="84dp" android:layout_height="48dp" />
</LinearLayout>
